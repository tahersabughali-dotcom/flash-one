# Flash One environment template
#
# Names only. Never put real values in this file.
# Copy to .env.local for local overrides (gitignored).
#
# Legend:
#   [required]           needed for core app/auth against Supabase
#   [optional]           feature remains fail-closed until set
#   [development-only]   must never be enabled in Production
#   [production-only]    configure only for Production launch

# ---------------------------------------------------------------------------
# Supabase [required]
# ---------------------------------------------------------------------------
# Server-only names. Do not prefix service credentials with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
#
# Browser-safe publishable configuration required by Supabase SSR Auth.
# These are not service-role secrets. Access still depends on RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
#
# Server-only privileged key for verified payment ingestion.
# Used only by webhook handlers and the development_test confirm path.
# Never prefix with NEXT_PUBLIC_. Never put this value in the browser.
SUPABASE_SECRET_KEY=
# Legacy alias accepted if SUPABASE_SECRET_KEY is unset.
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Application [optional]
# ---------------------------------------------------------------------------
# Public site origin used for absolute links when configured.
# NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Payments [optional] — fail closed when absent
# ---------------------------------------------------------------------------
# Sandbox/test values belong in gitignored .env.local.
# Development/sandbox credentials must never be production credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
WISE_API_TOKEN=
WORLDFIRST_API_TOKEN=
USDT_TRON_ADDRESS=
USDT_ETHEREUM_ADDRESS=

# ---------------------------------------------------------------------------
# Development payment / AI gates [development-only]
# ---------------------------------------------------------------------------
FLASH_ONE_ENABLE_DEV_PAYMENT_PROVIDER=
FLASH_ONE_ENABLE_DEV_AI_PROVIDER=

# ---------------------------------------------------------------------------
# AI [optional] — fail closed when absent
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Email [optional] — fail closed when absent
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
EMAIL_REPLY_TO=

# ---------------------------------------------------------------------------
# Optional integrations / scanners [optional] [production-only readiness]
# ---------------------------------------------------------------------------
# MALWARE_SCANNER_PROVIDER=
# MALWARE_SCANNER_API_KEY=
